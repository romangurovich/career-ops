    date: string,
    company: string,
    role: string,
    status: string,
    score: float,
    score-str: string,
    has-pdf: bool,
    has-report: bool,
    report-path: string,
    report-number: string,
    job-url: string,
    notes: string,
    location: string,
    work-mode: string,
    pay-range: string,
    pay-max: float,
    posted-on: string,
    last-contact: string,
    archetype: string,
    tldr: string,
}

